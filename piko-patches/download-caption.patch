+package app.morphe.extension.newx.misc;
+
+import android.content.res.Resources;
+
+import org.json.JSONObject;
+
+import java.io.BufferedReader;
+import java.io.InputStreamReader;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+import app.morphe.extension.newx.settings.NewXLogger;
+
+final class DownloadCaption {
+    private DownloadCaption() {
+    }
+
+    static String translate(String text) {
+        if (text == null || text.trim().isEmpty()) return text;
+        HttpURLConnection connection = null;
+        try {
+            Locale locale = Resources.getSystem().getConfiguration().getLocales().get(0);
+            String language = locale.getLanguage();
+            if (language.equals("zh")) {
+                language = locale.getScript().equals("Hant") || locale.getCountry().equals("TW")
+                        || locale.getCountry().equals("HK") || locale.getCountry().equals("MO")
+                        ? "zh-TW" : "zh-CN";
+            }
+            String query = URLEncoder.encode(DownloadFileName.truncate(text, 1200), "UTF-8");
+            URL url = new URL("https://ftapi.pythonanywhere.com/translate?dl="
+                    + URLEncoder.encode(language, "UTF-8") + "&text=" + query);
+            connection = (HttpURLConnection) url.openConnection();
+            connection.setConnectTimeout(5000);
+            connection.setReadTimeout(5000);
+            connection.setRequestProperty("Accept", "application/json");
+            try (BufferedReader reader = new BufferedReader(new InputStreamReader(
+                    connection.getInputStream(), StandardCharsets.UTF_8))) {
+                StringBuilder response = new StringBuilder();
+                char[] buffer = new char[2048];
+                int count;
+                while ((count = reader.read(buffer)) != -1) {
+                    if (response.length() + count > 65536) {
+                        throw new IllegalStateException("Translation response is too large");
+                    }
+                    response.append(buffer, 0, count);
+                }
+                String translated = new JSONObject(response.toString()).optString("destination-text");
+                return translated.trim().isEmpty() ? text : translated;
+            }
+        } catch (Exception exception) {
+            NewXLogger.printException(() -> "Could not translate download caption", exception);
+            return text;
+        } finally {
+            if (connection != null) connection.disconnect();
+        }
+    }
+}
