+    static boolean usesCaption(String template) {
+        return template != null && (template.contains("{" + TOKEN_TEXT + "}")
+                || template.contains("{" + TOKEN_TRANSLATED_TEXT + "}"));
+    }
+
+    static String postCaption(String postText) {
+        if (postText == null) return null;
+        int start = postText.indexOf(", text=");
+        if (start < 0) return null;
+        start += 7;
+        int end = postText.indexOf(", timestamp=", start);
+        if (end < 0) return null;
+        String text = postText.substring(start, end);
+        return text.equals("null") ? null : text;
+    }
+
+    static String limitFileName(String fileName) {
+        int dot = fileName.lastIndexOf('.');
+        String extension = dot > 0 ? fileName.substring(dot) : "";
+        if (extension.getBytes(StandardCharsets.UTF_8).length > 20) extension = "";
+        String stem = extension.isEmpty() ? fileName : fileName.substring(0, dot);
+        return truncate(stem, 240 - extension.getBytes(StandardCharsets.UTF_8).length) + extension;
+    }
+
+    static String truncate(String value, int maxBytes) {
+        int end = 0;
+        int bytes = 0;
+        while (end < value.length()) {
+            int codePoint = value.codePointAt(end);
+            int size = codePoint <= 0x7f ? 1 : codePoint <= 0x7ff ? 2 : codePoint <= 0xffff ? 3 : 4;
+            if (bytes + size > maxBytes) break;
+            bytes += size;
+            end += Character.charCount(codePoint);
+        }
+        return value.substring(0, end);
+    }
+
